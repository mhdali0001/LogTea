{
    "name": "logtea/tools",
    "description": "LogTea - PDF, image and document tools platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "setasign/fpdi-tcpdf": "^2.3",
        "smalot/pdfparser": "^2.9",
        "phpoffice/phpword": "^1.2",
        "phpoffice/phpspreadsheet": "^2.0 || ^3.0 || ^4.0",
        "phpoffice/phppresentation": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "LogTea\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
