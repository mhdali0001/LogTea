{
    "name": "logtea/tools",
    "description": "LogTea - web design company website with free PDF, image and document tools",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "setasign/fpdi-tcpdf": "^2.3",
        "smalot/pdfparser": "^2.9",
        "phpoffice/phpword": "^1.2",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpoffice/phppresentation": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "LogTea\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.0.30"
        }
    }
}
