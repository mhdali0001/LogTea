# This project's web root is the `public/` folder — point your host's
# document root there. This file is a safety net in case it is ever
# misconfigured to serve the project root instead.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
